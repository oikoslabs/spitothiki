rules_version = '2';
// Security rules for Σπιτοθήκη sync. Paste into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).members; }

    // Each user remembers which household they use.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId']) && request.resource.data.householdId is string && request.resource.data.householdId.size() <= 128;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Everyone starts with a personal household whose id is their uid.
      allow create: if signedIn() && hid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['ownerUid', 'members', 'createdAt']);
      allow update: if signedIn() && (
        // The owner can manage the household (not hand it over); other members can only leave (remove themselves).
        (request.auth.uid == resource.data.ownerUid && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.keys().hasOnly(['ownerUid', 'members', 'createdAt', 'lastJoinCode'])
          && request.resource.data.members is list && request.resource.data.members.size() <= 20
          && request.auth.uid in request.resource.data.members)
        || (request.auth.uid in resource.data.members && request.auth.uid != resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
        // Non-members can only add themselves, with a valid invite code.
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoinCode'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
          && resource.data.members.size() < 20
          && request.resource.data.lastJoinCode is string
          && exists(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.lastJoinCode))
          // Invite codes expire after 7 days.
          && get(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.lastJoinCode)).data.createdAt > request.time - duration.value(7, 'd'))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Products and shopping-list rows, one document each.
      match /records/{recordId} {
        allow read, delete: if isMember(hid);
        // Only the sync row shape is accepted (abuse guard).
        allow create, update: if isMember(hid) && request.resource.data.keys().hasOnly(['kind', 'id', 'data', 'deleted', 'ts', 'by']) && request.resource.data.by == request.auth.uid
          && request.resource.data.kind is string && request.resource.data.kind.size() <= 40
          && request.resource.data.id is string && request.resource.data.id.size() <= 200
          && request.resource.data.deleted is bool && request.resource.data.ts is number
          && (request.resource.data.data == null || request.resource.data.data is map);
      }
      // Invite codes created by members; their existence is what lets someone join.
      match /invites/{code} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.keys().hasOnly(['createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      }
    }
  }
}
